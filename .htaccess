# Apache's default mod_mime Content-Type for .js/.css has no charset
# parameter, unlike PHP-served .html (which correctly sends charset=UTF-8).
# Without this, some browsers/proxies can misinterpret this theme's UTF-8
# source (e.g. German umlauts in src/i18n/de.js) as a different encoding.
AddCharset UTF-8 .js .css

# Defence-in-depth: deny direct access to dotfiles and dev/build metadata.
# Apache's own <FilesMatch "^\.ht"> only covers .htaccess/.htpasswd — this
# theme directory is served directly, so anything else here (a stray .env,
# coverage.xml, package.json, *.log, docs) would otherwise be downloadable.
# This is an extension denylist, not an allowlist: it only stops the
# extensions already seen leaking (most recently .sh/.properties in bin/,
# and .txt via a stray resume.txt) — the next unlisted extension is still
# served. The RewriteRule below closes the whole bin/ and tests/ directories
# instead of chasing extensions one at a time.
<FilesMatch "^\.|\.(log|json|lock|md|xml|yml|sh|properties|txt)$">
    Require all denied
</FilesMatch>

# Dev tooling (bin/) and PHPUnit fixtures (tests/) should never be
# web-reachable at all, regardless of file extension — tests/*.php was
# previously executing through Apache directly (fatal error, not a 403),
# which both disclosed that the path exists and could leak debug output.
RewriteEngine On
RewriteRule ^(bin|tests)(/|$) - [F,L]
